NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
RESEND_API_KEY=
# Shared with the Apps Script in each survey sheet (scripts/apps-script/survey-sync.gs)
SURVEY_SYNC_SECRET=
# Shared with the name tag printer laptop (github.com/00Zero/thermal-printer), which polls /api/name-tags/feed
NAME_TAG_FEED_SECRET=
# Optional. Comma-separated emails whose name tags say "Host" (matched against verified profile emails)
NAME_TAG_HOST_EMAILS=
# Optional. Fine-grained GitHub token, read-only access to public repositories; raises GitHub's API limit from 60/hour per IP to 5,000/hour
GITHUB_TOKEN=
# Media uploads (scripts/apps-script/media-upload.gs): the Apps Script web app URL, and the secret it shares with the site
MEDIA_UPLOAD_URL=
MEDIA_UPLOAD_SECRET=

# Feedback button: a Slack incoming webhook, and the label each message starts with.
SLACK_FEEDBACK_WEBHOOK_URL=
FEEDBACK_SITE_LABEL=ClaudeSEA

# Feedback email (Admin -> Email): Resend webhook signing secret (Resend -> Webhooks, endpoint
# /api/email/resend-webhook, events delivered, opened, bounced, complained), and where replies go.
RESEND_WEBHOOK_SECRET=
FOLLOWUP_REPLY_TO=
